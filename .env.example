# ---------------------------------------------------------------
# Project brief email delivery (Resend — free tier: 3,000 emails/mo)
# ---------------------------------------------------------------
# 1. Create a free account at https://resend.com
# 2. API Keys → Create API Key → copy it here
# 3. Copy this file to .env.local (never commit .env.local)
#
# Without RESEND_API_KEY the form still works: it falls back to
# opening the visitor's mail app with the brief pre-filled.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where briefs are delivered. Defaults to site.email in lib/site.ts
BRIEF_TO_EMAIL=hello@growframestudio.bond

# Sender address. Until you verify your domain in Resend, leave the
# default below — Resend allows onboarding@resend.dev for testing.
# After verifying growframestudio.bond, switch to:
#   BRIEF_FROM_EMAIL=GrowFrame Briefs <briefs@growframestudio.bond>
BRIEF_FROM_EMAIL=GrowFrame Briefs <onboarding@resend.dev>
